# RECYCLINK Environment Configuration
PROJECT_NAME="RECYCLINK"
TAGLINE="From Informal Collection to Formal Recycling."
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to SQLite for hackathon local dev; supports PostgreSQL)
DATABASE_URL="sqlite:///./recyclink.db"
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/recyclink

# Security & Authentication
SECRET_KEY="recyclink-sih-2026-secret-key-production-ready-jwt-hash"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Demo & Simulation Mode
ENABLE_DEMO_MODE=True
ENABLE_ANOMALY_DETECTOR=True
PRICE_ANOMALY_THRESHOLD_PCT=40.0
